# 复制为 .env 后填写。密钥只保存在服务端，不会发送到浏览器。
# LLM_PROVIDER: openai（任何 OpenAI 兼容的 /chat/completions 接口）或 anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# 可选：DataForSEO API Access 的登录名与密码。仅服务端使用。
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 推荐的低频按次 Amazon 数据源。配置后优先于 DataForSEO。
APIFY_API_TOKEN=
# false 跳过评论登录与采集，保留证据缺口；完成 Apify Actor 登录后可改 true。
APIFY_REVIEWS_ENABLED=false

# 新增：免登录美国站公开评论；不会启用上方需要登录的旧 Actor。
APIFY_NO_LOGIN_REVIEWS_ENABLED=true
